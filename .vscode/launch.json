    "version": "0.2.0",
    "configurations": [
        {
            "name": "flutter_books",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": ["--enable-impeller"],
            "windows": {
                "args": [],
            },
            "env": {
                "RUST_LOG": "rust_lib,ark_application,ark_backend_panda",
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "name": "flutter_books (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter_books (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--enable-impeller"],
            "windows": {
                "args": [],
            },
            "env": {
                "RUST_LOG": "rust_lib,ark_application"
            }
        }
    ]
}